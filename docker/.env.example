TZ=Asia/Calcutta
DOMAIN=example.com

EMAIL_ID=
CF_API_TOKEN=

# Base paths
LCL_USER_DOCUMENTS_BASE=${HOME}/Documents
LCL_USER_DOWNLOADS_BASE=${HOME}/Downloads
LCL_CONFIG_DATA_BASE=${HOME}/Documents/server/data
LCL_DB_BASE=${LCL_CONFIG_DATA_BASE}/db
LCL_MONITOR_BASE=${LCL_CONFIG_DATA_BASE}/monitor
LCL_MEDIA_BASE=${LCL_CONFIG_DATA_BASE}/media
LCL_AI_BASE=${LCL_CONFIG_DATA_BASE}/ai
EXT_STORAGE_BASE=/Volumes/storage/storage
EXT_MEDIA_BASE=${EXT_STORAGE_BASE}/media
EXT_SEEDBOX_BASE=${EXT_STORAGE_BASE}/seedbox

# Monitor
LCL_PROMETHEUS_DATA=${LCL_MONITOR_BASE}/prometheus
LCL_GRAFANA_DATA=${LCL_MONITOR_BASE}/grafana

# Utilities
LCL_FIREFOX_CONFIG=${LCL_CONFIG_DATA_BASE}/utilites/firefox
LCL_DOWNLOADS_DATA=${LCL_USER_DOWNLOADS_BASE}/firefox
FILEBROWSER_ADMIN_PASSWORD=replace_with_strong_password

# Media
LCL_QBIT_DOWNLOADS=${LCL_USER_DOWNLOADS_BASE}/qbit

LCL_QBIT_CONFIG=${LCL_MEDIA_BASE}/qbit
LCL_PROWLARR_CONFIG=${LCL_MEDIA_BASE}/prowlarr
LCL_RADARR_CONFIG=${LCL_MEDIA_BASE}/radarr

# Dawarich
LCL_DAWARICH_BASE=${LCL_CONFIG_DATA_BASE}/dawarich
DAWARICH_APP_PORT=3000
DAWARICH_DB_USER=dawarich
DAWARICH_DB_PASSWORD=replace_with_strong_password
DAWARICH_DB_NAME=dawarich_production
DAWARICH_SECRET_KEY_BASE=replace_with_hex_64_secret_key
DAWARICH_HOSTS=dawarich.example.com,localhost,127.0.0.1
DAWARICH_PROTOCOL=https

# Multica
LCL_MULTICA_BASE=${LCL_AI_BASE}/multica
LCL_MULTICA_DB=${LCL_MULTICA_BASE}/pg
LCL_MULTICA_UPLOADS=${LCL_MULTICA_BASE}/uploads
MULTICA_APP_ENV=development
MULTICA_FRONTEND_PORT=3005
MULTICA_BACKEND_PORT=8085
MULTICA_JWT_SECRET=replace_with_openssl_rand_hex_32
MULTICA_DB_USER=multica
MULTICA_DB_PASSWORD=replace_with_strong_password
MULTICA_DB_NAME=multica
MULTICA_DEV_VERIFICATION_CODE=123456
MULTICA_APP_URL=https://multica.example.com
MULTICA_PUBLIC_URL=https://multica.example.com
MULTICA_FRONTEND_ORIGIN=https://multica.example.com
MULTICA_CORS_ALLOWED_ORIGINS=https://multica.example.com,http://multica.example.com,http://192.168.1.2:3005,http://localhost:3005,http://127.0.0.1:3005

# GitHub App Integration
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY=
